#######################
# Test Configurations #
#######################

# Set an OpenRouter API key and endpoint (optional) for tests.
# OpenRouter API keys typically start with "sk-or-v1-". Keep your key secret.
OPENROUTER_API_KEY="sk-or-v1-..."
# OPENROUTER_ENDPOINT_URL="https://openrouter.ai/api/v1"

# Optional comma-separated model overrides for integration tests. Unset or blank
# values use Horizon's built-in defaults.
# OPENROUTER_TEXT_MODELS="openrouter/free,openrouter/auto"
# OPENROUTER_MULTIMODAL_MODELS="openrouter/free,openrouter/auto"

# Set an OpenAI API key for tests (optional).
# OPENAI_API_KEY="sk-proj-..."

#####################################
# Horizon Environment Configuration #
#####################################

# From horizon/config.Config (unset values use these defaults)
#
# HORIZON_RENDERER_CACHE_SIZE=128
# HORIZON_PROVIDER_CACHE_SIZE=32
# HORIZON_MAX_TOOL_TURNS=32
# HORIZON_ATTACHMENT_MAX_DOWNLOAD_BYTES=67108864
# HORIZON_ATTACHMENT_DOWNLOAD_TIMEOUT=8s
# HORIZON_EXECUTION_TIMEOUT=0s
# HORIZON_FINALIZE_TIMEOUT=8s
# HORIZON_PROVIDER_REQUEST_TIMEOUT=128s
# HORIZON_HTTP_CLIENT_TIMEOUT=768s
