#!/usr/bin/env bash

##################
# CI Check Script #
##################

# Description: Runs the checks used by the Horizon CI workflow.
# Usage: ./ci_check [-c]
#
# Checks:
# - gofmt
# - go vet
# - staticcheck
# - go generate
# - go test with the race detector and coverage
#
# Pass -c to use the normal Go test cache. Without -c, tests run uncached.

set -u -o pipefail

cd "$(dirname "$0")" || exit 1

if [[ -f .env ]]; then
  set -a
  # shellcheck disable=SC1091
  source .env
  set +a
fi

if [[ "${1:-}" == "-c" ]]; then
  cached=true
  gotestargs=("-race" "-v")
else
  cached=false
  gotestargs=("-race" "-v" "-count=1")
fi

failed=()

run_step() {
  local name="$1"
  shift

  echo -e "\033[33mRunning: $name\033[0m"
  if "$@"; then
    echo -e "\033[32mPASS: $name\033[0m"
  else
    echo -e "\033[31mFAIL: $name\033[0m"
    failed+=("$name")
  fi
}

run_step "gofmt check" bash -c '[[ -z "$(gofmt -l .)" ]]'
run_step "go vet" go vet ./...
run_step "staticcheck" bash -c 'command -v staticcheck >/dev/null 2>&1 && staticcheck ./...'
run_step "code generation" go generate ./...
run_step "go test (cached: $cached)" go test -coverprofile=coverage.txt -covermode=atomic "${gotestargs[@]}" ./...

if [[ "${#failed[@]}" -eq 0 ]]; then
  echo -e "\n\033[32mAll checks passed.\033[0m"
  exit 0
fi

echo -e "\n\033[31mFailed steps:\033[0m"
for step in "${failed[@]}"; do
  echo "- $step"
done
exit 1
